# Environment (development or production)
ENVIRONMENT=development

# Database - PostgreSQL
# For free hosting, use Neon (https://neon.tech) or Supabase (https://supabase.com).
# Both offer free tiers that do not expire (unlike Render's free PostgreSQL).
# The app auto-appends ?sslmode=require if not present (needed by both providers).
# Local dev fallback: sqlite:///./tracesky.db
DATABASE_URL=postgresql://user:password@host/dbname

# Redis Cache (leave empty to use in-memory cache fallback)
REDIS_URL=redis://localhost:6379

# JWT Secret (generate a strong random key for production)
JWT_SECRET_KEY=your-secret-key-change-in-production

# Frontend URL (for CORS and redirect URIs - set to Vercel URL in production)
FRONTEND_URL=http://localhost:5173

# Cookie Settings (auto-set based on ENVIRONMENT)
COOKIE_SECURE=

# Google OAuth (optional - leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# WeatherAPI.com API Key (https://www.weatherapi.com - free tier: 1M calls/month)
WEATHERAPI_KEY=

# SMTP Email (optional - leave empty to disable password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=TraceSky AI
